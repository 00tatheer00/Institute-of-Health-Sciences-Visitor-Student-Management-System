# Backend runtime configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ihs-visitor-management

# REQUIRED in production: generate a long, random value.
# Do not use the development fallback in backend/index.js.
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated production frontend origins.
ALLOWED_ORIGINS=https://your-frontend.example
